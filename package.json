{
  "name": "ai-architect-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI architecture learning, practical labs, and reusable agent skills",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "report": "node scripts/completeness.js",
    "validate": "node scripts/validate-bank.js",
    "check:anchors": "node scripts/check-anchors.mjs",
    "ratings:pull": "node scripts/ratings-pull.mjs",
    "report:architect": "node scripts/completeness.js --course architect",
    "report:developer": "node scripts/completeness.js --course developer",
    "validate:architect": "node scripts/validate-bank.js --course architect",
    "validate:developer": "node scripts/validate-bank.js --course developer",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:preserved": "node scripts/check-preserved.mjs",
    "check:content": "pnpm validate:architect && pnpm validate:developer && pnpm check:anchors",
    "check:lessons": "python3 skills/format-course-module/scripts/validate.py --course architect --coverage && python3 skills/format-course-module/scripts/validate.py --course developer --coverage",
    "check:skills": "node scripts/check-skills.mjs",
    "skills:build": "python3 scripts/build-skills.py",
    "check": "pnpm check:foundation && pnpm check:skills && pnpm lint && pnpm test",
    "check:local-content": "pnpm check:preserved && pnpm check:content && pnpm check:lessons && python3 scripts/check-skill-overlap.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "gray-matter": "^4.0.3",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
